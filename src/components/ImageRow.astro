---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface ImageItem {
	src: ImageMetadata | string;
	alt: string;
}

interface Props {
	group?: string;
	images: ImageItem[];
}

const { group, images } = Astro.props;

const assetModules = import.meta.glob('../assets/application/**/*.{png,PNG,jpg,JPG,jpeg,JPEG,webp,WEBP,avif,AVIF}', {
	eager: true,
	import: 'default',
}) as Record<string, ImageMetadata>;

function resolveImage(src: ImageMetadata | string) {
	if (typeof src !== 'string') return src;

	const assetPath = group
		? `../assets/application/${group}/${src}`
		: `../assets/application/${src}`;

	const image = assetModules[assetPath];

	if (!image) {
		throw new Error(`ImageRow could not find local image: ${assetPath}`);
	}

	return image;
}

const resolved = images.map((image) => ({ alt: image.alt, src: resolveImage(image.src) }));
const totalRatio = resolved.reduce((sum, { src }) => sum + src.width / src.height, 0);
/** 全是竖图（手机截图）还是有横图（电脑、播放器）：手机上的排法按这个分（见下面 max-width 那段） */
const portrait = resolved.every(({ src }) => src.width < src.height);
---

<!--
	Each figure grows in proportion to its aspect ratio, so every image in a row
	ends up the same height (a landscape player shot sits level with portrait
	ones). --row-max caps that height so one or two phone screenshots don't fill
	the whole viewport; a capped row is centred.
-->
<div
	class="image-row"
	data-many={resolved.length > 2 ? '' : undefined}
	data-count={resolved.length}
	data-portrait={portrait ? '' : undefined}
	data-wide={resolved.length === 1 && totalRatio > 1 ? '' : undefined}
>
	{resolved.map(({ src, alt }) => (
		<figure class="image-card" style={`--ratio: ${src.width / src.height};`}>
			<a href={src.src} target="_blank" rel="noopener">
				<Image
					src={src}
					alt={alt}
					loading="lazy"
					sizes={`(max-width: 50rem) ${Math.round((100 * src.width) / src.height / totalRatio)}vw, ${Math.round((48 * src.width) / src.height / totalRatio)}rem`}
				/>
			</a>
		</figure>
	))}
</div>

<style>
	.image-row {
		--row-max: 28rem;
		display: flex;
		justify-content: center;
		gap: 0.75rem;
		margin: 1rem 0 1.5rem;
	}

	/* A lone landscape shot (a player screen) would otherwise span the full column and dwarf the phones above it. */
	.image-row[data-wide] {
		--row-max: 21rem;
	}

	.image-card {
		flex: var(--ratio) 1 0;
		min-width: 0;
		max-width: calc(var(--row-max) * var(--ratio));
		margin: 0;
	}

	/* 点图在新标签页打开原图，手机上可以双指放大 */
	.image-card a {
		display: block;
		cursor: zoom-in;
	}

	.image-card img {
		display: block;
		width: 100%;
		height: auto;
	}

	/* 手机上不许有落单的一张（2026-10-14 用户：「能不能不要有一张独立出来」）：
	 *   · 三张竖图（添加服务器的三步）并排一行，比例照桌面版，点开可看大图；
	 *   · 四张竖图 2 × 2；
	 *   · 横图（电脑截图）三张以上一张占一行——并排三张每张只剩一百来像素宽，两两一行又落单一张。 */
	@media (max-width: 40rem) {
		.image-row {
			--row-max: 24rem;
			gap: 0.5rem;
		}

		.image-row[data-portrait][data-count='4'] {
			flex-wrap: wrap;
		}

		.image-row[data-portrait][data-count='4'] .image-card {
			flex: 0 0 calc(50% - 0.25rem);
			max-width: none;
		}

		.image-row[data-many]:not([data-portrait]) {
			flex-direction: column;
		}

		.image-row[data-many]:not([data-portrait]) .image-card {
			flex: none;
			max-width: none;
		}
	}
</style>
