---
/**
 * 「照着填」的字段卡：客户端添加服务器、连接信息这类一项对一值的内容。
 * 以前写成两列表格（项目 / 填写），表头是废话、宽度随内容忽长忽短，嵌在步骤里很难看（2026-10-14 用户）。
 * 这里做成表单的样子：左边字段名弱化，右边是要填的值；值里可以写 `代码`、**加粗** 和 [链接](地址)。
 */
interface Props {
	rows: [string, string][];
}

const { rows } = Astro.props;

const escape = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const inline = (s: string) =>
	escape(s)
		.replace(/`([^`]+)`/g, '<code>$1</code>')
		.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
		.replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, '<a href="$2">$1</a>');
---

<dl class="lx-fields not-content">
	{
		rows.map(([label, value]) => (
			<div class="lx-field">
				<dt>{label}</dt>
				<dd set:html={inline(value)} />
			</div>
		))
	}
</dl>

<style>
	.lx-fields {
		margin: 1rem 0 1.25rem;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 10px;
		overflow: hidden;
	}

	.lx-field {
		display: grid;
		grid-template-columns: 8.5rem 1fr;
		gap: 1rem;
		padding: 0.7rem 1.1rem;
		align-items: baseline;
	}

	.lx-field + .lx-field {
		border-top: 1px solid var(--sl-color-hairline);
	}

	dt {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}

	dd {
		margin: 0;
		font-size: var(--sl-text-sm);
		line-height: 1.6;
		color: var(--sl-color-white);
	}

	dd :global(code) {
		padding: 0.1em 0.45em;
		border-radius: 5px;
		background: var(--sl-color-bg-inline-code);
		font-size: 0.875em;
		/* SHA-256 这种 64 位的串在手机上一行放不下，不断开就被卡片裁掉；
		 * 用 anywhere 不用 break-all：短的（https://）整段换到下一行，只有一行放不下的长串才从中间断 */
		overflow-wrap: anywhere;
	}

	dd :global(strong) {
		font-weight: 600;
	}

	dd :global(a) {
		color: var(--lumen-accent-text);
	}

	/* SHA-256 这类长串不能把卡片撑破 */
	dd {
		overflow-wrap: anywhere;
	}

	/* 手机上仍是左右两栏，只把字段名那栏收窄：上下叠放时每一项占两行，五项就是半屏（2026-10-14） */
	@media (max-width: 30rem) {
		.lx-field {
			grid-template-columns: 5.75rem 1fr;
			gap: 0.75rem;
			padding: 0.65rem 0.9rem;
		}
	}
</style>
