---

<div class="client-directory">
	<table>
		<thead>
			<tr>
				<th scope="col">客户端</th>
				<th scope="col">支持平台</th>
				<th scope="col">价格</th>
				<th scope="col">获取</th>
			</tr>
		</thead>
		<tbody>
			{clients.map((client) => (
				<tr>
					<td class="client-cell" data-label="客户端">
						<span class="client-inner">
							{client.icon ? (
								<img class="app-icon" src={client.icon} alt="" loading="lazy" data-no-zoom />
							) : (
								<span
									class="app-mark"
									style={`--app-color: ${client.color ?? 'var(--sl-color-accent)'}`}
									aria-hidden="true"
								>
									{client.name.slice(0, 1)}
								</span>
							)}
							<span class="client-copy">
								<span class="name-line">
									<a href={client.href} target="_blank" rel="noopener noreferrer">{client.name}</a>
									{client.badge && <span class="badge">{client.badge}</span>}
								</span>
								<span class="description">{client.description}</span>
							</span>
						</span>
					</td>
					<td class="platform-cell" data-label="支持平台">{client.platform}</td>
					<td class="price-cell" data-label="价格">
						<span class:list={['price', { free: client.price === '免费' }]}>{client.price}</span>
					</td>
					<td class="source-cell" data-label="获取">
						<a href={client.href} target="_blank" rel="noopener noreferrer">
							{sourceIcons[client.source] && (
								<svg
									class="source-icon"
									viewBox="0 0 24 24"
									aria-hidden="true"
									fill={sourceIcons[client.source].stroke ? 'none' : 'currentColor'}
									stroke={sourceIcons[client.source].stroke ? 'currentColor' : 'none'}
									stroke-width={sourceIcons[client.source].stroke ? '2' : undefined}
									set:html={sourceIcons[client.source].svg}
								/>
							)}
							<span>{client.source} ↗</span>
						</a>
					</td>
				</tr>
			))}
		</tbody>
	</table>
</div>

<style>
	.client-directory {
		margin-block: 1.5rem;
	}

	table {
		display: table;
		width: 100%;
		margin: 0;
		border-collapse: collapse;
		font-size: var(--sl-text-base, 1rem);
	}

	th {
		padding: 0 0.75rem 0.55rem;
		border: 0;
		border-bottom: 1px solid var(--sl-color-hairline);
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-xs, 0.8125rem);
		font-weight: 600;
		letter-spacing: 0.04em;
		text-align: left;
	}

	th:first-child,
	td:first-child {
		padding-left: 0;
	}

	th:last-child,
	td:last-child {
		padding-right: 0;
	}

	td {
		padding: 0.7rem 0.75rem;
		border: 0;
		border-bottom: 1px solid var(--sl-color-hairline-light);
		vertical-align: middle;
	}

	.client-cell {
		min-width: 11rem;
	}

	.client-inner {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.app-icon,
	.app-mark {
		width: 2.4rem;
		height: 2.4rem;
		flex: 0 0 auto;
		border-radius: 0.6rem;
	}

	.app-icon {
		object-fit: cover;
		border: 1px solid var(--sl-color-hairline-light);
		margin: 0;
	}

	.app-mark {
		display: grid;
		place-items: center;
		background: color-mix(in srgb, var(--app-color) 16%, transparent);
		color: var(--app-color);
		font-size: 1.05rem;
		font-weight: 650;
		line-height: 1;
	}

	.client-copy {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		min-width: 0;
	}

	.name-line {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.name-line a {
		color: var(--sl-color-white);
		font-weight: 600;
		text-decoration: none;
	}

	.name-line a:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.description {
		display: block;
		margin-top: 0.15rem;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm, 0.875rem);
	}

	.badge {
		color: var(--sl-color-accent-high);
		font-size: var(--sl-text-xs, 0.8125rem);
		white-space: nowrap;
	}

	.platform-cell {
		color: var(--sl-color-gray-2);
	}

	.price-cell {
		white-space: nowrap;
	}

	.price {
		color: var(--sl-color-gray-2);
	}

	.price.free {
		color: var(--sl-color-green-high, var(--sl-color-gray-2));
	}

	.source-cell {
		white-space: nowrap;
	}

	.source-cell a {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm, 0.875rem);
		text-decoration: none;
	}

	.source-icon {
		width: 0.95rem;
		height: 0.95rem;
		flex: 0 0 auto;
		opacity: 0.75;
	}

	.source-cell a:hover .source-icon {
		opacity: 1;
	}

	.source-cell a:hover {
		color: var(--sl-color-white);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	@media (max-width: 48rem) {
		table,
		tbody {
			display: block;
			width: 100%;
		}

		thead {
			display: none;
		}

		/* App Store 式列表行:
		   [图标] 名称+描述        [价格徽章]
		          平台             [来源按钮]  */
		tbody tr {
			display: grid;
			grid-template-columns: auto minmax(0, 1fr) auto;
			grid-template-rows: auto auto;
			column-gap: 0.75rem;
			row-gap: 0.4rem;
			align-items: center;
			padding-block: 0.8rem;
			border-bottom: 1px solid var(--sl-color-hairline-light);
		}

		td {
			padding: 0;
			border: 0;
		}

		/* 拆掉 td 包装,让图标/文字直接成为网格项 */
		.client-cell,
		.client-inner {
			display: contents;
		}

		.app-icon,
		.app-mark {
			grid-column: 1;
			grid-row: 1 / span 2;
			width: 2.9rem;
			height: 2.9rem;
			border-radius: 0.7rem;
			align-self: center;
		}

		.client-copy {
			display: flex;
			flex-direction: column;
			gap: 0.1rem;
			grid-column: 2;
			grid-row: 1;
			min-width: 0;
		}

		.description {
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
		}

		.platform-cell {
			grid-column: 2;
			grid-row: 2;
			min-width: 0;
			color: var(--sl-color-gray-3);
			font-size: var(--sl-text-xs, 0.8125rem);
			line-height: 1.4;
		}

		.price-cell {
			grid-column: 3;
			grid-row: 1;
			justify-self: end;
		}

		.price {
			display: inline-block;
			padding: 0.14rem 0.55rem;
			border-radius: 999px;
			background: var(--sl-color-gray-6);
			color: var(--sl-color-gray-2);
			font-size: var(--sl-text-xs, 0.8125rem);
			font-weight: 600;
			white-space: nowrap;
		}

		.price.free {
			background: color-mix(in srgb, #31b887 14%, transparent);
			color: var(--sl-color-green-high, #2a9d6f);
		}

		.source-cell {
			grid-column: 3;
			grid-row: 2;
			justify-self: end;
		}

		.source-cell a {
			gap: 0.3rem;
			padding: 0.28rem 0.6rem;
			border: 1px solid var(--sl-color-hairline);
			border-radius: 999px;
			font-size: var(--sl-text-xs, 0.8125rem);
			white-space: nowrap;
		}
	}
</style>
