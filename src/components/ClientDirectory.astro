---
interface Client {
	name: string;
	description: string;
	price: '免费' | '付费';
	platform: string;
	source: string;
	href: string;
	badge?: string;
	color?: string;
	/** 可选:真实应用图标(如 import 的本地图片或 URL),提供后替代字母色块 */
	icon?: string;
}

interface Props {
	clients: Client[];
}

const { clients } = Astro.props;

/** 来源 → 品牌图标(24×24 viewBox 的 path 数据) */
