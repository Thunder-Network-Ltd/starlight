---
/**
 * 首页「选择您的设备」：拼贴式卡片，卡片上半是画面、下半是名称与客户端。
 *   · 浏览器：Lumen 自己的界面（「我的媒体库」，深浅两版跟主题切换），横跨两格；
 *   · Apple / Android / Android TV / Windows：品牌图标做成 App 图标样的方块，带一点品牌色的光。
 * 一稿 Apple、电视两格放的是 SenPlayer / Rex / Yamby 的截图，用户：「像宣传别人 app 了，而不是我的东西」（2026-10-14）；
 * 安卓手机客户端的界面用户也嫌难看。首页只放我们自己的界面，第三方客户端的截图留在各自的教程页。
 * 此前是六张同样的「图标 + 文字」卡，用户嫌首页「很单调，全是文字」。
 */
import { Image } from 'astro:assets';
import libLight from '../../assets/panel/libraries-overview-light.webp';
import libDark from '../../assets/panel/libraries-overview-dark.webp';

type Glyph = { d: string; stroke?: boolean };
const glyphs: Record<string, Glyph> = {
	apple: {
		d: 'M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.03 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.56-1.701',
	},
	android: {
		d: 'M17.6 9.48l1.84-3.18c.16-.31.04-.69-.26-.85a.637.637 0 0 0-.83.22l-1.88 3.24a11.463 11.463 0 0 0-8.94 0L5.65 5.67a.643.643 0 0 0-.87-.2c-.28.18-.37.54-.22.83L6.4 9.48A10.78 10.78 0 0 0 1 18h22a10.78 10.78 0 0 0-5.4-8.52zM7 15.25a1.25 1.25 0 1 1 0-2.5 1.25 1.25 0 0 1 0 2.5zm10 0a1.25 1.25 0 1 1 0-2.5 1.25 1.25 0 0 1 0 2.5z',
	},
	tv: { d: 'M3 6.5A1.5 1.5 0 0 1 4.5 5h15A1.5 1.5 0 0 1 21 6.5v10a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 16.5zM8 21h8M12 18v3', stroke: true },
	windows: { d: 'M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.9-1.801' },
};

const platforms = [
	{ cls: 'lx-dev-apple', glyph: 'apple', brand: 'var(--sl-color-white)', name: 'iPhone · iPad · Mac · Apple TV', clients: 'SenPlayer · Infuse · Rex', href: '/clients/apple/' },
	{ cls: 'lx-dev-android', glyph: 'android', brand: '#3ddc84', name: 'Android 手机与平板', clients: 'Yamby · Hills · AfuseKt', href: '/clients/android/' },
	{ cls: 'lx-dev-tv', glyph: 'tv', brand: '#7aa7ff', name: 'Android TV 与机顶盒', clients: 'Yamby · Flow · TVxEmby', href: '/clients/android/#android-tv-与机顶盒' },
	{ cls: 'lx-dev-windows', glyph: 'windows', brand: '#3a96dd', name: 'Windows', clients: '小幻影视 · Hills Lite', href: '/clients/windows/' },
];
---

<ul class="lx-dev">
	<li class="lx-dev-web">
		<a href="/watch/web/">
			<div class="lx-stage">
				<div class="lx-web dark:sl-hidden">
					<Image src={libLight} alt="" widths={[600, 1000]} sizes="(max-width: 50rem) 90vw, 560px" />
				</div>
				<div class="lx-web light:sl-hidden">
					<Image src={libDark} alt="" widths={[600, 1000]} sizes="(max-width: 50rem) 90vw, 560px" />
				</div>
			</div>
			<div class="lx-meta">
				<span class="lx-name">浏览器</span>
				<span class="lx-clients">电脑、平板和手机，不用安装，直接在线观看</span>
			</div>
		</a>
	</li>
	{
		platforms.map((p) => {
			const g = glyphs[p.glyph];
			return (
				<li class={p.cls}>
					<a href={p.href}>
						<div class="lx-stage lx-stage-glyph" style={`--brand: ${p.brand}`}>
							<span class="lx-glyph">
								<svg
									viewBox="0 0 24 24"
									aria-hidden="true"
									fill={g.stroke ? 'none' : 'currentColor'}
									stroke={g.stroke ? 'currentColor' : 'none'}
									stroke-width={g.stroke ? 1.8 : undefined}
									stroke-linecap="round"
									stroke-linejoin="round"
								>
									<path d={g.d} />
								</svg>
							</span>
						</div>
						<div class="lx-meta">
							<span class="lx-name">{p.name}</span>
							<span class="lx-clients">{p.clients}</span>
						</div>
					</a>
				</li>
			);
		})
	}
</ul>

<style>
	.lx-dev {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.875rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	li {
		margin: 0;
	}

	.lx-dev-web {
		grid-column: span 2;
	}

	a {
		display: flex;
		flex-direction: column;
		height: 100%;
		overflow: hidden;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 16px;
		background: var(--lumen-panel);
		color: inherit;
		text-decoration: none;
		transition:
			border-color 0.2s ease,
			transform 0.2s ease;
	}

	a:hover,
	a:focus-visible {
		border-color: color-mix(in srgb, var(--lumen-accent) 60%, transparent);
	}

	/* 画面区：上方一团淡蓝光，图从里面「长」出来、下沿被卡片裁掉 */
	.lx-stage {
		position: relative;
		height: 15rem;
		overflow: hidden;
		background: radial-gradient(ellipse 70% 80% at 50% 0%, var(--lumen-glow), transparent 75%);
	}

	.lx-stage :global(img) {
		position: absolute;
		height: auto;
		transition: transform 0.35s ease;
	}

	a:hover .lx-stage :global(img) {
		transform: translateY(-4px);
	}

	/* 浏览器：截图像一扇窗从下方升上来，只露上半 */
	.lx-web {
		position: absolute;
		top: 1.75rem;
		left: 6%;
		width: 88%;
	}

	.lx-web :global(img) {
		position: static;
		width: 100%;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 10px;
		box-shadow: 0 18px 40px rgb(0 0 0 / 0.25);
	}

	/* 品牌图标卡：图标放进一块 App 图标样的圆角方块，带一点品牌色的光 */
	.lx-stage-glyph {
		display: grid;
		place-items: center;
		background:
			radial-gradient(ellipse 60% 70% at 50% 45%, color-mix(in srgb, var(--brand, var(--lumen-accent)) 18%, transparent), transparent 70%);
	}

	.lx-glyph {
		display: grid;
		place-items: center;
		width: 5.5rem;
		height: 5.5rem;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 1.4rem;
		background: linear-gradient(160deg, var(--sl-color-gray-6), var(--lumen-panel));
		box-shadow: 0 16px 36px rgb(0 0 0 / 0.25);
		color: var(--brand);
		transition: transform 0.35s ease;
	}

	.lx-glyph svg {
		width: 2.75rem;
		height: 2.75rem;
	}

	a:hover .lx-glyph {
		transform: translateY(-4px);
	}

	.lx-meta {
		display: grid;
		gap: 0.2rem;
		padding: 1rem 1.25rem 1.125rem;
		border-top: 1px solid var(--sl-color-hairline);
	}

	.lx-name {
		font-weight: 600;
		color: var(--sl-color-white);
	}

	.lx-clients {
		font-size: var(--sl-text-sm);
		color: var(--lumen-muted);
	}

	@media (max-width: 50rem) {
		.lx-dev {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 0.625rem;
		}

		.lx-dev-web {
			grid-column: span 2;
		}

		.lx-stage {
			height: 12rem;
		}

		.lx-stage-glyph {
			height: 8.5rem;
		}

		.lx-glyph {
			width: 4.25rem;
			height: 4.25rem;
			border-radius: 1.1rem;
		}

		.lx-glyph svg {
			width: 2.1rem;
			height: 2.1rem;
		}

		.lx-meta {
			padding: 0.875rem 1rem 1rem;
		}

		/* 两列的小卡里平台名长（「iPhone · iPad · Mac · Apple TV」），收一档免得折三行 */
		li:not(.lx-dev-web) .lx-name {
			font-size: var(--sl-text-sm);
		}

		li:not(.lx-dev-web) .lx-clients {
			font-size: var(--sl-text-xs);
		}
	}
</style>
