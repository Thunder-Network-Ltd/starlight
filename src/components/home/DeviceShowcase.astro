---
/**
 * 首页「选择您的设备」：一排五个平台，不套卡片——单色大图标 + 平台名 + 可用客户端，悬停时图标换品牌色。
 * 迭代（2026-10-14）：第三方客户端截图（「像宣传别人 app」）→ 拼贴大卡（「太大了，空白太多了」）→
 * 五张带图标方块和箭头的小卡（「我不喜欢」：又是一排框，和上面四步、下面主题卡连成一片）。
 * 现在这一节没有框，和上面那条分格面板形状不同；手机改成一行一个的列表。
 */
// vb：图形本身偏扁的（Android 头只占 24 格里的 13 格高）放大一点，和其余几个看起来一样大
type Glyph = { d: string; stroke?: boolean; vb?: string };

const glyphs: Record<string, Glyph> = {
	web: {
		d: 'M3 5.5A1.5 1.5 0 0 1 4.5 4h15A1.5 1.5 0 0 1 21 5.5v13a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 18.5zM3 8.5h18M10 11.5v5l4.5-2.5z',
		stroke: true,
	},
	apple: {
		d: 'M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.03 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.56-1.701',
	},
	android: {
		vb: '2 1 20 20',
		d: 'M17.6 9.48l1.84-3.18c.16-.31.04-.69-.26-.85a.637.637 0 0 0-.83.22l-1.88 3.24a11.463 11.463 0 0 0-8.94 0L5.65 5.67a.643.643 0 0 0-.87-.2c-.28.18-.37.54-.22.83L6.4 9.48A10.78 10.78 0 0 0 1 18h22a10.78 10.78 0 0 0-5.4-8.52zM7 15.25a1.25 1.25 0 1 1 0-2.5 1.25 1.25 0 0 1 0 2.5zm10 0a1.25 1.25 0 1 1 0-2.5 1.25 1.25 0 0 1 0 2.5z',
	},
	tv: { d: 'M3 6.5A1.5 1.5 0 0 1 4.5 5h15A1.5 1.5 0 0 1 21 6.5v10a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 16.5zM8 21h8M12 18v3', stroke: true },
	windows: { d: 'M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.9-1.801' },
};

const platforms = [
	{ glyph: 'web', brand: 'var(--lumen-accent)', name: '浏览器', clients: '不用安装，打开就能看', href: '/watch/web/' },
	{ glyph: 'apple', brand: 'var(--sl-color-white)', name: 'Apple 设备', clients: 'SenPlayer · Infuse · Rex', href: '/clients/apple/' },
	{ glyph: 'android', brand: '#3ddc84', name: 'Android', clients: 'Yamby · Hills · AfuseKt', href: '/clients/android/' },
	{ glyph: 'tv', brand: '#7aa7ff', name: 'Android TV', clients: 'Yamby · Flow · TVxEmby', href: '/clients/android/#android-tv-与机顶盒' },
	{ glyph: 'windows', brand: '#3a96dd', name: 'Windows', clients: '小幻影视 · Hills Lite', href: '/clients/windows/' },
];
---

<ul class="lx-dev">
	{
		platforms.map((p) => {
			const g = glyphs[p.glyph];
			return (
				<li>
					<a href={p.href} style={`--brand: ${p.brand}`}>
						<svg
							class="lx-glyph"
							viewBox={g.vb ?? '0 0 24 24'}
							aria-hidden="true"
							fill={g.stroke ? 'none' : 'currentColor'}
							stroke={g.stroke ? 'currentColor' : 'none'}
							stroke-width={g.stroke ? 1.6 : undefined}
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<path d={g.d} />
						</svg>
						<span class="lx-name">{p.name}</span>
						<span class="lx-clients">{p.clients}</span>
					</a>
				</li>
			);
		})
	}
</ul>

<style>
	.lx-dev {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		margin: 0;
		padding: 0;
		list-style: none;
	}

	li {
		margin: 0;
	}

	a {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.25rem;
		padding: 1.5rem 0.75rem 1.25rem;
		border-radius: 14px;
		color: inherit;
		text-align: center;
		text-decoration: none;
		transition: background-color 0.2s ease;
	}

	a:hover,
	a:focus-visible {
		background: var(--lumen-panel);
	}

	.lx-glyph {
		width: 2.5rem;
		height: 2.5rem;
		margin-bottom: 0.875rem;
		overflow: visible;
		color: var(--sl-color-gray-2);
		transition: color 0.2s ease;
	}

	a:hover .lx-glyph,
	a:focus-visible .lx-glyph {
		color: var(--brand);
	}

	.lx-name {
		font-weight: 600;
		color: var(--sl-color-white);
	}

	.lx-clients {
		font-size: var(--sl-text-xs);
		line-height: 1.5;
		color: var(--lumen-muted);
	}

	/* 手机：一行一个，图标在左，行间细线 */
	@media (max-width: 40rem) {
		.lx-dev {
			grid-template-columns: 1fr;
		}

		li + li {
			border-top: 1px solid var(--sl-color-hairline-light);
		}

		a {
			display: grid;
			grid-template-columns: 1.75rem 1fr auto;
			column-gap: 1rem;
			row-gap: 0.05rem;
			align-items: center;
			padding: 0.875rem 0.25rem;
			border-radius: 0;
			text-align: start;
		}

		a::after {
			content: '›';
			grid-column: 3;
			grid-row: 1 / span 2;
			font-size: 1.25rem;
			color: var(--sl-color-gray-4);
		}

		a:hover,
		a:focus-visible {
			background: none;
		}

		.lx-glyph {
			grid-row: 1 / span 2;
			width: 1.75rem;
			height: 1.75rem;
			margin: 0;
		}

		.lx-name {
			grid-column: 2;
		}

		.lx-clients {
			grid-column: 2;
		}
	}
</style>
