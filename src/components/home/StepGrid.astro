---
/**
 * 编号卡片栅格（01 / 02 / 03 …）：整张卡可点，卡与卡之间是 1px 细线，
 * 复刻落地页「专为影迷设计」那一段的版式。
 */
interface Step {
	title: string;
	body: string;
	href: string;
	cta?: string;
}

interface Props {
	steps: Step[];
}

const { steps } = Astro.props;
const external = (href: string) => /^https?:\/\//.test(href);
---

<ol class="lx-steps" style={`--lx-cols: ${Math.min(steps.length, 4)}`}>
	{
		steps.map((step, i) => (
			<li>
				<a
					href={step.href}
					{...(external(step.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
				>
					<span class="lx-num">{String(i + 1).padStart(2, '0')}</span>
					<span class="lx-step-title">{step.title}</span>
					<span class="lx-step-body">{step.body}</span>
					<span class="lx-step-cta">
						{step.cta ?? '查看教程'}
						<span aria-hidden="true">{external(step.href) ? '↗' : '→'}</span>
					</span>
				</a>
			</li>
		))
	}
</ol>

<style>
	.lx-steps {
		display: grid;
		grid-template-columns: repeat(var(--lx-cols), minmax(0, 1fr));
		gap: 1px;
		margin: 0;
		padding: 0;
		list-style: none;
		background: var(--sl-color-hairline-light);
		border: 1px solid var(--sl-color-hairline-light);
	}

	li {
		display: flex;
		background: var(--lumen-panel);
	}

	a {
		display: flex;
		flex-direction: column;
		gap: 0.625rem;
		width: 100%;
		padding: 1.75rem 1.5rem 1.5rem;
		color: inherit;
		text-decoration: none;
		transition: background-color 0.15s ease;
	}

	a:hover,
	a:focus-visible {
		background: color-mix(in srgb, var(--lumen-accent) 7%, var(--lumen-panel));
	}

	.lx-num {
		font-size: var(--sl-text-sm);
		font-variant-numeric: tabular-nums;
		color: var(--lumen-accent-text);
	}

	.lx-step-title {
		font-size: var(--sl-text-lg);
		font-weight: 500;
		color: var(--sl-color-white);
	}

	.lx-step-body {
		flex: 1;
		font-size: var(--sl-text-sm);
		line-height: 1.75;
		color: var(--lumen-muted);
	}

	.lx-step-cta {
		display: inline-flex;
		gap: 0.375rem;
		margin-top: 0.5rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-2);
	}

	a:hover .lx-step-cta {
		color: var(--lumen-accent-text);
	}

	@media (max-width: 64rem) {
		.lx-steps {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 36rem) {
		.lx-steps {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
