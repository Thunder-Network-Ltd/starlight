---
/**
 * 两栏链接清单：标题 + 一句说明 + 箭头，行与行之间只有细分隔线。
 * 用在首页「常见问题」「控制台指南」这类「知道要找什么」的入口。
 */
interface Item {
	title: string;
	description: string;
	href: string;
}

interface Props {
	items: Item[];
}

const { items } = Astro.props;
---

<ul class="lx-links">
	{
		items.map((item) => (
			<li>
				<a href={item.href}>
					<span class="lx-link-copy">
						<span class="lx-link-title">{item.title}</span>
						<span class="lx-link-desc">{item.description}</span>
					</span>
					<span class="lx-link-arrow" aria-hidden="true">
						→
					</span>
				</a>
			</li>
		))
	}
</ul>

<style>
	.lx-links {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		column-gap: 2.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--sl-color-hairline);
	}

	li {
		border-bottom: 1px solid var(--sl-color-hairline);
	}

	a {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 1rem 0.25rem;
		color: inherit;
		text-decoration: none;
	}

	.lx-link-copy {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: 0.25rem;
		min-width: 0;
	}

	.lx-link-title {
		font-weight: 500;
		color: var(--sl-color-white);
		transition: color 0.15s ease;
	}

	.lx-link-desc {
		font-size: var(--sl-text-xs);
		line-height: 1.6;
		color: var(--lumen-muted);
	}

	.lx-link-arrow {
		flex: none;
		color: var(--sl-color-gray-4);
		transition:
			color 0.15s ease,
			transform 0.15s ease;
	}

	a:hover .lx-link-title,
	a:focus-visible .lx-link-title,
	a:hover .lx-link-arrow {
		color: var(--lumen-accent-text);
	}

	a:hover .lx-link-arrow {
		transform: translateX(2px);
	}

	@media (max-width: 44rem) {
		.lx-links {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
