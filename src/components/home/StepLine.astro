---
/**
 * 「开始使用」：四步排成一条横向的步骤线——序号圈之间连一条细线，每一步整块可点。
 * 取代原来的四个方框卡片（每张底下还各带一个「查看步骤 →」，四个按钮抢眼又重复）。窄屏改成竖排，线在左侧。
 */
interface Step {
	title: string;
	body: string;
	href: string;
}

interface Props {
	steps: Step[];
}

const { steps } = Astro.props;
---

<ol class="lx-stepline" style={`--n: ${steps.length}`}>
	{
		steps.map((step, i) => (
			<li>
				<a href={step.href}>
					<span class="lx-sl-num">{i + 1}</span>
					<span class="lx-sl-title">{step.title}</span>
					<span class="lx-sl-body">{step.body}</span>
				</a>
			</li>
		))
	}
</ol>

<style>
	.lx-stepline {
		--dot: 2rem;
		display: grid;
		grid-template-columns: repeat(var(--n), minmax(0, 1fr));
		gap: 1.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	li {
		position: relative;
		margin: 0;
	}

	/* 连线：从这一格的序号圈右边起，接到下一格的序号圈左边（跨过 gap） */
	li:not(:last-child)::after {
		content: '';
		position: absolute;
		top: calc(var(--dot) / 2);
		left: calc(var(--dot) + 0.75rem);
		right: calc(-1.5rem + 0.75rem);
		height: 1px;
		background: var(--sl-color-hairline-light);
	}

	a {
		display: grid;
		gap: 0.5rem;
		color: inherit;
		text-decoration: none;
	}

	.lx-sl-num {
		display: grid;
		place-items: center;
		width: var(--dot);
		height: var(--dot);
		margin-bottom: 0.5rem;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 999px;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		font-variant-numeric: tabular-nums;
		color: var(--lumen-accent-text);
		transition:
			border-color 0.15s ease,
			background-color 0.15s ease;
	}

	.lx-sl-title {
		font-weight: 600;
		color: var(--sl-color-white);
		transition: color 0.15s ease;
	}

	.lx-sl-body {
		font-size: var(--sl-text-sm);
		line-height: 1.7;
		color: var(--lumen-muted);
	}

	a:hover .lx-sl-num,
	a:focus-visible .lx-sl-num {
		border-color: var(--lumen-accent);
		background: var(--sl-color-accent-low);
	}

	a:hover .lx-sl-title,
	a:focus-visible .lx-sl-title {
		color: var(--lumen-accent-text);
	}

	@media (max-width: 50rem) {
		.lx-stepline {
			grid-template-columns: 1fr;
			gap: 0;
		}

		li {
			padding-bottom: 1.25rem;
		}

		/* 竖排：线改到左边，从序号圈底下接到下一步的序号圈 */
		li:not(:last-child)::after {
			top: calc(var(--dot) + 0.375rem);
			bottom: 0.375rem;
			left: calc(var(--dot) / 2);
			right: auto;
			width: 1px;
			height: auto;
		}

		a {
			grid-template-columns: var(--dot) 1fr;
			column-gap: 1rem;
			row-gap: 0.25rem;
		}

		.lx-sl-num {
			grid-row: 1 / span 2;
			align-self: start;
			margin: 0;
		}

		.lx-sl-title {
			align-self: center;
			min-height: var(--dot);
			display: flex;
			align-items: center;
		}
	}
</style>
