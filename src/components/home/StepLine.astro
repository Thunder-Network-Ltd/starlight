---
/**
 * 「四步开始观看」：一整条面板分成四格，格与格之间一道细竖线；每格只有步骤号、标题、一句说明，整格可点。
 * 迭代（2026-10-14）：「序号圈 + 细连线」的步骤线（用户：「这个模块很丑」）→ 四张带图标、左上角发光的小卡
 * （和下面「选择您的设备」那排卡长得一样，连起来看又单调又重复）。现在两节形状不同：这里是一条分格面板，设备是独立小卡。
 * 窄屏两格一排，手机一列（格与格之间改成横线）。
 */
interface Step {
	title: string;
	body: string;
	href: string;
}

interface Props {
	steps: Step[];
}

const { steps } = Astro.props;
---

<ol class="lx-steps">
	{
		steps.map((step, i) => (
			<li>
				<a href={step.href}>
					<span class="lx-st-num">{i + 1}</span>
					<span class="lx-st-title">
						{step.title}
						<span class="lx-st-arrow" aria-hidden="true">→</span>
					</span>
					<span class="lx-st-body">{step.body}</span>
				</a>
			</li>
		))
	}
</ol>

<style>
	.lx-steps {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		margin: 0;
		padding: 0;
		overflow: hidden;
		list-style: none;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 16px;
		background: var(--lumen-panel);
	}

	li {
		margin: 0;
	}

	li + li {
		border-inline-start: 1px solid var(--sl-color-hairline-light);
	}

	a {
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
		height: 100%;
		padding: 1.5rem 1.5rem 1.625rem;
		color: inherit;
		text-decoration: none;
		transition: background-color 0.2s ease;
	}

	a:hover,
	a:focus-visible {
		background: color-mix(in srgb, var(--sl-color-white) 4%, transparent);
	}

	.lx-st-num {
		display: grid;
		place-items: center;
		width: 1.75rem;
		height: 1.75rem;
		margin-bottom: 0.75rem;
		border-radius: 50%;
		background: var(--lumen-accent);
		font-size: var(--sl-text-sm);
		font-weight: 600;
		font-variant-numeric: tabular-nums;
		color: #fff;
	}

	.lx-st-title {
		display: flex;
		align-items: center;
		gap: 0.375rem;
		font-weight: 600;
		color: var(--sl-color-white);
	}

	.lx-st-arrow {
		color: var(--sl-color-gray-4);
		opacity: 0;
		transform: translateX(-4px);
		transition:
			opacity 0.2s ease,
			transform 0.2s ease;
	}

	a:hover .lx-st-arrow,
	a:focus-visible .lx-st-arrow {
		color: var(--lumen-accent-text);
		opacity: 1;
		transform: translateX(0);
	}

	.lx-st-body {
		font-size: var(--sl-text-sm);
		line-height: 1.7;
		color: var(--lumen-muted);
	}

	@media (max-width: 60rem) {
		.lx-steps {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		li:nth-child(3) {
			border-inline-start: 0;
		}

		li:nth-child(n + 3) {
			border-top: 1px solid var(--sl-color-hairline-light);
		}
	}

	/* 手机：一列，步骤号在左 */
	@media (max-width: 30rem) {
		.lx-steps {
			grid-template-columns: 1fr;
		}

		li + li {
			border-inline-start: 0;
			border-top: 1px solid var(--sl-color-hairline-light);
		}

		a {
			display: grid;
			grid-template-columns: 1.75rem 1fr;
			column-gap: 0.875rem;
			row-gap: 0.1rem;
			padding: 1rem 1.125rem;
		}

		.lx-st-num {
			grid-row: 1 / span 2;
			align-self: start;
			margin: 0.1rem 0 0;
		}
	}
</style>
