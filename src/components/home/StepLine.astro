---
/**
 * 「四步开始观看」：四张小卡排一行，卡片左上是步骤号、右上一个图标，下面标题与一句说明，整张可点；
 * 卡与卡之间一个淡淡的箭头表示先后。窄屏两列，手机一列（箭头不出）。
 * 一稿是「序号圈 + 细连线」的横向步骤线，用户嫌这个模块丑（2026-10-14）。
 */
type StepIcon = 'user' | 'card' | 'route' | 'device';

interface Step {
	title: string;
	body: string;
	href: string;
	icon: StepIcon;
}

interface Props {
	steps: Step[];
}

const { steps } = Astro.props;

const icons: Record<StepIcon, string> = {
	user: 'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM4.5 20a7.5 7.5 0 0 1 15 0',
	card: 'M3 7.5A1.5 1.5 0 0 1 4.5 6h15A1.5 1.5 0 0 1 21 7.5v9a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 16.5zM3 10h18M7 14.5h4',
	route: 'M6 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM18 9a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM6 15V9a4 4 0 0 1 4-4h6M18 9v6a4 4 0 0 1-4 4H8',
	device: 'M3 6.5A1.5 1.5 0 0 1 4.5 5h15A1.5 1.5 0 0 1 21 6.5v10a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 16.5zM8 21h8M12 18v3M10.5 9.5v4l3.5-2z',
};
---

<ol class="lx-steps">
	{
		steps.map((step, i) => (
			<li>
				<a href={step.href}>
					<span class="lx-st-top">
						<span class="lx-st-num">{String(i + 1).padStart(2, '0')}</span>
						<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d={icons[step.icon]} />
						</svg>
					</span>
					<span class="lx-st-title">{step.title}</span>
					<span class="lx-st-body">{step.body}</span>
				</a>
			</li>
		))
	}
</ol>

<style>
	.lx-steps {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	li {
		position: relative;
		margin: 0;
	}

	/* 卡与卡之间的小箭头，压在间隙正中 */
	li:not(:last-child)::after {
		content: '';
		position: absolute;
		top: 50%;
		right: -0.95rem;
		width: 0.5rem;
		height: 0.5rem;
		border-top: 1.5px solid var(--sl-color-gray-4);
		border-right: 1.5px solid var(--sl-color-gray-4);
		transform: translateY(-50%) rotate(45deg);
	}

	a {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		height: 100%;
		overflow: hidden;
		padding: 1.25rem 1.25rem 1.375rem;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 16px;
		background:
			radial-gradient(ellipse 90% 60% at 0% 0%, var(--lumen-glow), transparent 70%),
			var(--lumen-panel);
		color: inherit;
		text-decoration: none;
		transition:
			border-color 0.2s ease,
			transform 0.2s ease;
	}

	a:hover,
	a:focus-visible {
		border-color: color-mix(in srgb, var(--lumen-accent) 60%, transparent);
		transform: translateY(-2px);
	}

	.lx-st-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 1.5rem;
		color: var(--lumen-accent-text);
	}

	.lx-st-num {
		font-size: 1.75rem;
		font-weight: 600;
		line-height: 1;
		font-variant-numeric: tabular-nums;
		letter-spacing: -0.02em;
		background: linear-gradient(160deg, var(--lumen-accent-text), color-mix(in srgb, var(--lumen-accent-text) 35%, transparent));
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	svg {
		opacity: 0.85;
	}

	.lx-st-title {
		font-weight: 600;
		color: var(--sl-color-white);
	}

	.lx-st-body {
		font-size: var(--sl-text-sm);
		line-height: 1.7;
		color: var(--lumen-muted);
	}

	@media (max-width: 60rem) {
		.lx-steps {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 0.75rem;
		}

		li::after {
			display: none;
		}
	}

	/* 手机：一行一步——左边大号步骤号，右边标题与说明，图标不出，一步只占两行字的高度 */
	@media (max-width: 30rem) {
		.lx-steps {
			grid-template-columns: 1fr;
			gap: 0.5rem;
		}

		a {
			display: grid;
			grid-template-columns: 2.75rem 1fr;
			column-gap: 0.75rem;
			row-gap: 0.15rem;
			padding: 0.875rem 1rem;
		}

		.lx-st-top {
			grid-row: 1 / span 2;
			align-self: center;
			margin: 0;
		}

		.lx-st-top svg {
			display: none;
		}

		.lx-st-num {
			font-size: 1.5rem;
		}
	}
</style>
