---
/**
 * 「按设备找教程」：每个平台一格，图标 + 平台名 + 推荐客户端。
 */
type DeviceIcon = 'apple' | 'android' | 'windows' | 'tv' | 'web' | 'together';

interface Device {
	name: string;
	clients: string;
	href: string;
	icon: DeviceIcon;
}

interface Props {
	devices: Device[];
}

const { devices } = Astro.props;

// 24×24 viewBox；apple / windows / android 取品牌轮廓，tv / web 用线框
const icons: Record<DeviceIcon, { d: string; stroke?: boolean }> = {
	apple: {
		d: 'M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.03 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.56-1.701',
	},
	android: {
		d: 'M17.6 9.48l1.84-3.18c.16-.31.04-.69-.26-.85a.637.637 0 0 0-.83.22l-1.88 3.24a11.463 11.463 0 0 0-8.94 0L5.65 5.67a.643.643 0 0 0-.87-.2c-.28.18-.37.54-.22.83L6.4 9.48A10.78 10.78 0 0 0 1 18h22a10.78 10.78 0 0 0-5.4-8.52zM7 15.25a1.25 1.25 0 1 1 0-2.5 1.25 1.25 0 0 1 0 2.5zm10 0a1.25 1.25 0 1 1 0-2.5 1.25 1.25 0 0 1 0 2.5z',
	},
	windows: {
		d: 'M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.9-1.801',
	},
	tv: {
		d: 'M3 6.5A1.5 1.5 0 0 1 4.5 5h15A1.5 1.5 0 0 1 21 6.5v10a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 16.5zM8 21h8M12 18v3',
		stroke: true,
	},
	web: {
		d: 'M3 5.5A1.5 1.5 0 0 1 4.5 4h15A1.5 1.5 0 0 1 21 5.5v13a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 18.5zM3 8.5h18M10 11.5v5l4.5-2.5z',
		stroke: true,
	},
	together: {
		d: 'M9 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7zM2.5 20a6.5 6.5 0 0 1 13 0M16 4.3a3.5 3.5 0 0 1 0 6.4M18.5 14.2A6.5 6.5 0 0 1 21.5 20',
		stroke: true,
	},
};
---

<ul class="lx-devices">
	{
		devices.map((device) => {
			const icon = icons[device.icon];
			return (
				<li>
					<a href={device.href}>
						<svg
							viewBox="0 0 24 24"
							width="22"
							height="22"
							aria-hidden="true"
							fill={icon.stroke ? 'none' : 'currentColor'}
							stroke={icon.stroke ? 'currentColor' : 'none'}
							stroke-width={icon.stroke ? 1.6 : undefined}
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<path d={icon.d} />
						</svg>
						<span class="lx-device-name">{device.name}</span>
						<span class="lx-device-clients">{device.clients}</span>
						<span class="lx-device-arrow" aria-hidden="true">
							→
						</span>
					</a>
				</li>
			);
		})
	}
</ul>

<style>
	.lx-devices {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	a {
		position: relative;
		display: grid;
		grid-template-columns: auto 1fr;
		grid-template-rows: auto auto;
		column-gap: 0.875rem;
		row-gap: 0.25rem;
		align-items: center;
		height: 100%;
		padding: 1.125rem 2.5rem 1.125rem 1.125rem;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 6px;
		background: var(--lumen-panel);
		color: inherit;
		text-decoration: none;
		transition: border-color 0.15s ease;
	}

	a:hover,
	a:focus-visible {
		border-color: var(--lumen-accent);
	}

	svg {
		grid-row: 1 / span 2;
		color: var(--sl-color-gray-1);
	}

	.lx-device-name {
		font-weight: 500;
		color: var(--sl-color-white);
	}

	.lx-device-clients {
		font-size: var(--sl-text-xs);
		color: var(--lumen-muted);
	}

	.lx-device-arrow {
		position: absolute;
		right: 1rem;
		top: 50%;
		transform: translateY(-50%);
		color: var(--sl-color-gray-4);
		transition:
			color 0.15s ease,
			transform 0.15s ease;
	}

	a:hover .lx-device-arrow {
		color: var(--lumen-accent-text);
		transform: translate(2px, -50%);
	}
</style>
