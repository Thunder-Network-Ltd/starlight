---
/**
 * 首页收尾：「还没找到答案」。一个主按钮（联系客服）+ 一个次按钮（交流群），其余入口做成一行小字链接。
 * 此前四个一样的描边按钮并排，没有主次（2026-10-14 首页重排）。
 */
interface Link {
	label: string;
	href: string;
}

interface Props {
	title: string;
	body: string;
	primary: Link;
	secondary: Link;
	more: Link[];
}

const { title, body, primary, secondary, more } = Astro.props;
---

<aside class="lx-help not-content">
	<div class="lx-help-glow" aria-hidden="true"></div>
	<p class="lx-help-title">{title}</p>
	<p class="lx-help-body">{body}</p>
	<div class="lx-help-actions">
		<a class="lx-btn lx-btn-primary" href={primary.href} target="_blank" rel="noopener noreferrer">{primary.label}</a>
		<a class="lx-btn" href={secondary.href} target="_blank" rel="noopener noreferrer">{secondary.label}</a>
	</div>
	<p class="lx-help-more">
		{
			more.map((link, i) => (
				<>
					{i > 0 && <span aria-hidden="true">·</span>}
					<a href={link.href} target="_blank" rel="noopener noreferrer">
						{link.label}
					</a>
				</>
			))
		}
	</p>
</aside>

<style>
	.lx-help {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
		margin-block: clamp(2rem, 5vh, 3rem) 1rem;
		padding: clamp(2rem, 5vw, 3rem) 1.5rem;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 16px;
		background: var(--lumen-panel);
		text-align: center;
	}

	.lx-help-glow {
		position: absolute;
		z-index: -1;
		inset: -40% 10% auto;
		height: 120%;
		background: radial-gradient(ellipse at 50% 0%, var(--lumen-glow), transparent 65%);
		pointer-events: none;
	}

	.lx-help-title {
		margin: 0;
		font-size: clamp(1.25rem, 1.1rem + 0.5vw, 1.5rem);
		font-weight: 600;
		color: var(--sl-color-white);
	}

	.lx-help-body {
		margin: 0;
		max-width: 32rem;
		font-size: var(--sl-text-sm);
		line-height: 1.75;
		color: var(--lumen-muted);
	}

	.lx-help-actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.625rem;
		margin-top: 0.5rem;
	}

	.lx-btn {
		padding: 0.6rem 1.25rem;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 8px;
		font-size: var(--sl-text-sm);
		font-weight: 500;
		color: var(--sl-color-white);
		text-decoration: none;
		transition:
			border-color 0.15s ease,
			background-color 0.15s ease;
	}

	.lx-btn:hover {
		border-color: var(--sl-color-gray-4);
	}

	.lx-btn-primary {
		border-color: var(--lumen-accent);
		background: var(--lumen-accent);
		color: #fff;
	}

	.lx-btn-primary:hover {
		border-color: var(--lumen-accent);
		background: color-mix(in srgb, var(--lumen-accent) 88%, #fff);
	}

	.lx-help-more {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem;
		margin: 0.25rem 0 0;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-4);
	}

	.lx-help-more a {
		color: var(--lumen-muted);
		text-decoration: none;
	}

	.lx-help-more a:hover {
		color: var(--sl-color-white);
	}
</style>
