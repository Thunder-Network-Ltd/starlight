---
/**
 * 首页收尾：「还没找到答案」+ 社群入口，对应落地页底部的「准备好开场了吗？」那一条。
 */
interface Link {
	label: string;
	href: string;
}

interface Props {
	title: string;
	body: string;
	links: Link[];
}

const { title, body, links } = Astro.props;
---

<aside class="lx-help not-content">
	<div class="lx-help-copy">
		<p class="lx-help-title">{title}</p>
		<p class="lx-help-body">{body}</p>
	</div>
	<div class="lx-help-links">
		{
			links.map((link) => (
				<a href={link.href} target="_blank" rel="noopener noreferrer">
					{link.label}
					<span aria-hidden="true">↗</span>
				</a>
			))
		}
	</div>
</aside>

<style>
	.lx-help {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		margin-block: 1rem 2rem;
		padding: 1.75rem 2rem;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 6px;
		background:
			radial-gradient(ellipse 60% 120% at 0% 0%, var(--lumen-glow), transparent 70%),
			var(--lumen-panel);
	}

	.lx-help-copy {
		min-width: min(100%, 18rem);
		flex: 1;
	}

	.lx-help-title {
		margin: 0 0 0.375rem;
		font-size: var(--sl-text-xl);
		font-weight: 500;
		color: var(--sl-color-white);
	}

	.lx-help-body {
		margin: 0;
		font-size: var(--sl-text-sm);
		line-height: 1.75;
		color: var(--lumen-muted);
	}

	.lx-help-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	a {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.625rem 1.125rem;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 6px;
		color: var(--sl-color-gray-1);
		font-size: var(--sl-text-sm);
		text-decoration: none;
		transition: border-color 0.15s ease;
	}

	a:hover,
	a:focus-visible {
		border-color: var(--lumen-accent);
		color: var(--sl-color-white);
	}
</style>
