---
/**
 * 首页 Hero：替换 Starlight 默认的「左文右图」版式，改成居中大标题 + 网格底纹 + 大搜索框。
 * 标题 / 标语从 index.mdx 的 hero 字段读；hero.actions 不再画成按钮，而是搜索框下面一排「常用」入口
 * （2026-10-14 首页重排：此前是「快速开始 / 前往控制台」两颗按钮，与下面的「开始使用」一节重复；
 * 标题上方「LUMEN DOCS · 帮助中心」那行小字与标题说的是同一件事，也去掉了）。
 * 背景是一道从页面顶上照下来的品牌蓝光束（纯 CSS），落在下面浮出的控制台首页上——像放映机打在银幕上；控制台深浅两版跟主题切换。
 * 2026-10-14 先后试过：第三方客户端截图拼图（「像宣传别人 app」）、浏览器 + 播放器拼图（「图不好看」）、
 * 落地页海报墙截图（「糊」）、自己用原图拼的透视海报墙（「变形了」「海报墙出现的地方有点多了，换一个背景」）。
 */

import { Image } from 'astro:assets';
import dashLight from '../assets/home/dashboard-light.webp';
import dashDark from '../assets/home/dashboard-dark.webp';

// Starlight 的「回到顶部」锚点靠这个 id；constants 不在包的公开导出里，只能照抄它的值
const PAGE_TITLE_ID = '_top';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
---

<section class="lx-hero not-content">
	<div class="lx-backdrop" aria-hidden="true">
		<div class="lx-beam"></div>
	</div>

	<h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />

	{tagline && <p class="lx-tagline" set:html={tagline} />}

	<button class="lx-search" type="button" data-lx-search disabled>
		<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
			<circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2" />
			<path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
		</svg>
		<span class="lx-search-label">搜索文档，例如「线路」「字幕」「流量」</span>
		<kbd data-lx-kbd>Ctrl K</kbd>
	</button>

	{
		actions.length > 0 && (
			<nav class="lx-popular" aria-label="常用">
				<span class="lx-popular-label">常用</span>
				{actions.map(({ link: href, text }) => (
					<a href={href}>{text}</a>
				))}
			</nav>
		)
	}

	<div class="lx-product" aria-hidden="true">
		<Image class="dark:sl-hidden" src={dashLight} alt="" widths={[1000, 1500, 2000]} sizes="(max-width: 64rem) 96vw, 1000px" loading="eager" />
		<Image class="light:sl-hidden" src={dashDark} alt="" widths={[1000, 1500, 2000]} sizes="(max-width: 64rem) 96vw, 1000px" loading="eager" />
	</div>
</section>

<script>
	// 大搜索框只是个入口：点它等于点页头那颗搜索按钮（Starlight 的 pagefind 弹窗）。
	// 必须拦住冒泡：弹窗打开时会在 window 上挂「点弹窗外就关」，这一下点击冒上去会立刻把它关掉
	const trigger = document.querySelector<HTMLButtonElement>('[data-lx-search]');
	const headerSearch = document.querySelector<HTMLButtonElement>('site-search button[data-open-modal]');
	if (trigger && headerSearch) {
		trigger.disabled = false;
		trigger.addEventListener('click', (event) => {
			event.stopPropagation();
			headerSearch.click();
		});
	}
	const kbd = document.querySelector<HTMLElement>('[data-lx-kbd]');
	if (kbd && /(Mac|iPhone|iPod|iPad)/i.test(navigator.platform)) kbd.textContent = '⌘ K';
</script>

<style>
	.lx-hero {
		position: relative;
		isolation: isolate;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 1.25rem;
		padding-block: clamp(4rem, 13vh, 8rem) 0;
	}

	/* 网格底纹：全出血、向四周淡出，顶上压一团很淡的蓝光 */
	/* 背景：全出血。网格放在 ::before 上单独渐隐（遮罩不能挂在整个背景上，否则光束也被一起盖掉）；
	 * 光束从页头底下中央照下来：锥形渐变 + 向下渐淡，光源处一团亮光，控制台窗口后面再垫一团光——像放映机打在银幕上 */
	.lx-backdrop {
		position: absolute;
		z-index: -1;
		top: calc(-1 * var(--sl-nav-height) - 2rem);
		bottom: 0;
		left: 50%;
		width: 100vw;
		overflow: hidden;
		transform: translateX(-50%);
		pointer-events: none;
	}

	.lx-backdrop::before {
		content: '';
		position: absolute;
		inset: 0;
		background:
			linear-gradient(var(--lumen-grid-line) 1px, transparent 1px) 0 0 / 56px 56px,
			linear-gradient(90deg, var(--lumen-grid-line) 1px, transparent 1px) 0 0 / 56px 56px;
		mask-image: radial-gradient(ellipse 75% 65% at 50% 35%, #000 20%, transparent 100%);
	}

	/* 光源放在页头下沿（背景层从页头上方 nav + 2rem 处开始，所以是 calc(var(--sl-nav-height) + 2rem)）：
	 * 此前放在背景最顶上，被半透明的页头挡掉一半，只剩一团蓝光糊在导航后面 */
	.lx-beam {
		--beam: var(--lumen-accent);
		--src: calc(var(--sl-nav-height) + 2rem);
		position: absolute;
		inset: 0;
		background:
			radial-gradient(ellipse 260px 70px at 50% var(--src), color-mix(in srgb, var(--beam) 45%, transparent), transparent 100%),
			radial-gradient(ellipse 40% 18% at 50% 74%, color-mix(in srgb, var(--beam) 22%, transparent), transparent 100%),
			conic-gradient(
				from 180deg at 50% var(--src),
				transparent 0deg 152deg,
				color-mix(in srgb, var(--beam) 8%, transparent) 162deg,
				color-mix(in srgb, var(--beam) 18%, transparent) 172deg,
				color-mix(in srgb, var(--beam) 24%, transparent) 180deg,
				color-mix(in srgb, var(--beam) 18%, transparent) 188deg,
				color-mix(in srgb, var(--beam) 8%, transparent) 198deg,
				transparent 208deg 360deg
			);
		filter: blur(8px);
		mask-image: linear-gradient(to bottom, transparent 0, #000 calc(var(--sl-nav-height) + 2rem), #000 55%, transparent 92%);
	}

	:global([data-theme='light']) .lx-beam {
		opacity: 0.55;
	}

	/* 控制台首页：窗口式的框、上沿一道细高光、底部渐隐接下面的内容 */
	.lx-product {
		position: relative;
		width: min(100%, 64rem);
		aspect-ratio: 2000 / 1100;
		margin-top: clamp(2.25rem, 6vh, 3.75rem);
		overflow: hidden;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 16px;
		background: var(--sl-color-black);
		box-shadow:
			0 0 0 1px color-mix(in srgb, var(--sl-color-white) 4%, transparent),
			0 40px 100px rgb(0 0 0 / 0.45);
		mask-image: linear-gradient(to bottom, #000 62%, transparent 100%);
	}

	.lx-product :global(img) {
		width: 100%;
		height: auto;
	}

	h1 {
		margin: 0;
		font-size: clamp(2rem, 1.2rem + 3.4vw, 3.5rem);
		font-weight: 600;
		line-height: 1.18;
		letter-spacing: -0.03em;
		color: var(--sl-color-white);
	}

	h1 :global(.g) {
		color: var(--lumen-accent-text);
	}

	/* 不能用 word-break: keep-all：它让中文只在标点处断行，balance 一平衡就把句末的「。」单独挤到下一行。
	 * 宽度放到一行放得下整句，窄屏再由 balance 均分成两行 */
	.lx-tagline {
		margin: 0;
		max-width: 42rem;
		text-wrap: balance;
		line-break: strict;
		font-size: clamp(0.9375rem, 0.85rem + 0.4vw, 1.0625rem);
		line-height: 1.8;
		color: var(--lumen-muted);
	}

	.lx-search {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		width: min(100%, 34rem);
		margin-top: 0.75rem;
		padding: 0.875rem 1rem;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 8px;
		background: color-mix(in srgb, var(--lumen-panel) 85%, transparent);
		backdrop-filter: blur(6px);
		color: var(--lumen-muted);
		font: inherit;
		font-size: var(--sl-text-sm);
		text-align: start;
		cursor: pointer;
		transition:
			border-color 0.15s ease,
			color 0.15s ease;
	}

	.lx-search:hover:not(:disabled),
	.lx-search:focus-visible {
		border-color: var(--lumen-accent);
		color: var(--sl-color-gray-1);
	}

	.lx-search:disabled {
		cursor: default;
	}

	.lx-search-label {
		flex: 1;
		min-width: 0;
		overflow: hidden;
		white-space: nowrap;
		text-overflow: ellipsis;
	}

	.lx-search kbd {
		flex: none;
		padding: 0.125rem 0.4rem;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 4px;
		font-family: inherit;
		font-size: 0.6875rem;
		color: var(--sl-color-gray-3);
	}

	.lx-popular {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: 0.5rem;
		max-width: 36rem;
		margin-top: 0.25rem;
	}

	.lx-popular-label {
		margin-inline-end: 0.25rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}

	.lx-popular a {
		padding: 0.3rem 0.75rem;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 999px;
		background: color-mix(in srgb, var(--lumen-panel) 70%, transparent);
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-2);
		text-decoration: none;
		transition:
			border-color 0.15s ease,
			color 0.15s ease;
	}

	.lx-popular a:hover,
	.lx-popular a:focus-visible {
		border-color: var(--lumen-accent);
		color: var(--sl-color-white);
	}

	@media (max-width: 40rem) {
		.lx-search kbd {
			display: none;
		}
	}
</style>
