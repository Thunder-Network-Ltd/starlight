---
/**
 * 首页 Hero：替换 Starlight 默认的「左文右图」版式，改成居中大标题 + 网格底纹 + 大搜索框。
 * 标题 / 标语从 index.mdx 的 hero 字段读；hero.actions 不再画成按钮，而是搜索框下面一排「常用」入口
 * （2026-10-14 首页重排：此前是「快速开始 / 前往控制台」两颗按钮，与下面的「开始使用」一节重复；
 * 标题上方「LUMEN DOCS · 帮助中心」那行小字与标题说的是同一件事，也去掉了）。
 * 底下是 Lumen 自己的界面：一个浏览器窗口（在线观影的详情页，深浅两版跟主题切换），前面叠一个网页播放器窗口（开着弹幕）。
 * 一稿用的是 SenPlayer / Rex 的 Mac 与 iPhone 截图，用户：「有点像宣传别人 app 了，而不是我的东西」（2026-10-14）——
 * 首页门面只放我们自己做的界面，第三方客户端留在各自的教程页里。
 */
import { Image } from 'astro:assets';
import detailLight from '../assets/panel/web-detail-light.webp';
import detailDark from '../assets/panel/web-detail-dark.webp';
import playerShot from '../assets/home/web-player-danmaku.webp';

// Starlight 的「回到顶部」锚点靠这个 id；constants 不在包的公开导出里，只能照抄它的值
const PAGE_TITLE_ID = '_top';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
---

<section class="lx-hero not-content">
	<div class="lx-backdrop" aria-hidden="true"></div>

	<h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />

	{tagline && <p class="lx-tagline" set:html={tagline} />}

	<button class="lx-search" type="button" data-lx-search disabled>
		<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
			<circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2" />
			<path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
		</svg>
		<span class="lx-search-label">搜索文档，例如「线路」「字幕」「流量」</span>
		<kbd data-lx-kbd>Ctrl K</kbd>
	</button>

	{
		actions.length > 0 && (
			<nav class="lx-popular" aria-label="常用">
				<span class="lx-popular-label">常用</span>
				{actions.map(({ link: href, text }) => (
					<a href={href}>{text}</a>
				))}
			</nav>
		)
	}

	<div class="lx-showcase" aria-hidden="true">
		<div class="lx-sc-glow"></div>
		<div class="lx-win lx-win-main">
			<div class="lx-win-bar">
				<span class="lx-dots"><i></i><i></i><i></i></span>
				<span class="lx-url">www.lumen.ax</span>
			</div>
			<div class="lx-win-body">
				<Image class="dark:sl-hidden" src={detailLight} alt="" widths={[900, 1300, 1600]} sizes="(max-width: 60rem) 80vw, 780px" loading="eager" />
				<Image class="light:sl-hidden" src={detailDark} alt="" widths={[900, 1300, 1600]} sizes="(max-width: 60rem) 80vw, 780px" loading="eager" />
			</div>
		</div>
		<div class="lx-win lx-win-player">
			<div class="lx-win-body">
				<Image src={playerShot} alt="" widths={[600, 900]} sizes="(max-width: 60rem) 48vw, 460px" loading="eager" />
			</div>
		</div>
	</div>
</section>

<script>
	// 大搜索框只是个入口：点它等于点页头那颗搜索按钮（Starlight 的 pagefind 弹窗）。
	// 必须拦住冒泡：弹窗打开时会在 window 上挂「点弹窗外就关」，这一下点击冒上去会立刻把它关掉
	const trigger = document.querySelector<HTMLButtonElement>('[data-lx-search]');
	const headerSearch = document.querySelector<HTMLButtonElement>('site-search button[data-open-modal]');
	if (trigger && headerSearch) {
		trigger.disabled = false;
		trigger.addEventListener('click', (event) => {
			event.stopPropagation();
			headerSearch.click();
		});
	}
	const kbd = document.querySelector<HTMLElement>('[data-lx-kbd]');
	if (kbd && /(Mac|iPhone|iPod|iPad)/i.test(navigator.platform)) kbd.textContent = '⌘ K';
</script>

<style>
	.lx-hero {
		position: relative;
		isolation: isolate;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 1.25rem;
		padding-block: clamp(3rem, 11vh, 7rem) clamp(1rem, 3vh, 2rem);
	}

	/* 网格底纹：全出血、向四周淡出，顶上压一团很淡的蓝光 */
	.lx-backdrop {
		position: absolute;
		z-index: -1;
		top: calc(-1 * var(--sl-nav-height) - 2rem);
		bottom: -6rem;
		left: 50%;
		width: 100vw;
		transform: translateX(-50%);
		pointer-events: none;
		background:
			radial-gradient(ellipse 50% 45% at 50% 32%, var(--lumen-glow), transparent 70%),
			linear-gradient(var(--lumen-grid-line) 1px, transparent 1px) 0 0 / 56px 56px,
			linear-gradient(90deg, var(--lumen-grid-line) 1px, transparent 1px) 0 0 / 56px 56px;
		mask-image: radial-gradient(ellipse 70% 75% at 50% 35%, #000 35%, transparent 100%);
	}

	h1 {
		margin: 0;
		font-size: clamp(2rem, 1.2rem + 3.4vw, 3.5rem);
		font-weight: 600;
		line-height: 1.18;
		letter-spacing: -0.03em;
		color: var(--sl-color-white);
	}

	h1 :global(.g) {
		color: var(--lumen-accent-text);
	}

	/* 不能用 word-break: keep-all：它让中文只在标点处断行，balance 一平衡就把句末的「。」单独挤到下一行。
	 * 宽度放到一行放得下整句，窄屏再由 balance 均分成两行 */
	.lx-tagline {
		margin: 0;
		max-width: 42rem;
		text-wrap: balance;
		line-break: strict;
		font-size: clamp(0.9375rem, 0.85rem + 0.4vw, 1.0625rem);
		line-height: 1.8;
		color: var(--lumen-muted);
	}

	.lx-search {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		width: min(100%, 34rem);
		margin-top: 0.75rem;
		padding: 0.875rem 1rem;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 8px;
		background: color-mix(in srgb, var(--lumen-panel) 85%, transparent);
		backdrop-filter: blur(6px);
		color: var(--lumen-muted);
		font: inherit;
		font-size: var(--sl-text-sm);
		text-align: start;
		cursor: pointer;
		transition:
			border-color 0.15s ease,
			color 0.15s ease;
	}

	.lx-search:hover:not(:disabled),
	.lx-search:focus-visible {
		border-color: var(--lumen-accent);
		color: var(--sl-color-gray-1);
	}

	.lx-search:disabled {
		cursor: default;
	}

	.lx-search-label {
		flex: 1;
		min-width: 0;
		overflow: hidden;
		white-space: nowrap;
		text-overflow: ellipsis;
	}

	.lx-search kbd {
		flex: none;
		padding: 0.125rem 0.4rem;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 4px;
		font-family: inherit;
		font-size: 0.6875rem;
		color: var(--sl-color-gray-3);
	}

	.lx-popular {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: 0.5rem;
		max-width: 36rem;
		margin-top: 0.25rem;
	}

	.lx-popular-label {
		margin-inline-end: 0.25rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}

	.lx-popular a {
		padding: 0.3rem 0.75rem;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 999px;
		background: color-mix(in srgb, var(--lumen-panel) 70%, transparent);
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-2);
		text-decoration: none;
		transition:
			border-color 0.15s ease,
			color 0.15s ease;
	}

	.lx-popular a:hover,
	.lx-popular a:focus-visible {
		border-color: var(--lumen-accent);
		color: var(--sl-color-white);
	}

	/* 界面拼图：浏览器窗口占 78% 靠左上，播放器窗口占 50% 压在右下；容器底部渐隐，接到下面的内容。
	 * 两扇窗都是 CSS 画的框（标题栏 + 圆角 + 阴影），截图本身不带框 */
	.lx-showcase {
		position: relative;
		width: min(100%, 60rem);
		aspect-ratio: 1 / 0.6;
		margin-top: clamp(1.5rem, 4vh, 2.75rem);
		mask-image: linear-gradient(to bottom, #000 74%, transparent 100%);
	}

	.lx-sc-glow {
		position: absolute;
		inset: 6% 10% 22%;
		background: radial-gradient(ellipse at 50% 45%, var(--lumen-glow), transparent 70%);
		filter: blur(24px);
	}

	.lx-win {
		position: absolute;
		overflow: hidden;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 12px;
		background: var(--lumen-panel);
		box-shadow: 0 30px 70px rgb(0 0 0 / 0.35);
	}

	.lx-win-main {
		top: 0;
		left: 2%;
		width: 78%;
		height: 92%;
	}

	.lx-win-player {
		right: 2%;
		bottom: 6%;
		width: 50%;
		aspect-ratio: 1600 / 948;
		border-color: rgb(255 255 255 / 0.14);
		box-shadow: 0 30px 80px rgb(0 0 0 / 0.55);
	}

	.lx-win-bar {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		height: 2rem;
		padding-inline: 0.75rem;
		border-bottom: 1px solid var(--sl-color-hairline);
		background: var(--sl-color-gray-6);
	}

	.lx-dots {
		display: flex;
		gap: 0.375rem;
	}

	.lx-dots i {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: var(--sl-color-gray-4);
		opacity: 0.6;
	}

	.lx-url {
		flex: 0 1 14rem;
		margin-inline: auto;
		padding: 0.15rem 0.75rem;
		border-radius: 6px;
		background: var(--lumen-panel);
		font-size: 0.6875rem;
		color: var(--sl-color-gray-3);
		text-align: center;
	}

	.lx-win-body {
		position: relative;
		height: calc(100% - 2rem);
	}

	.lx-win-player .lx-win-body {
		height: 100%;
	}

	.lx-win-body :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top;
	}

	@media (max-width: 40rem) {
		.lx-search kbd {
			display: none;
		}

		.lx-showcase {
			width: calc(100% + 1rem);
		}

		.lx-win-bar {
			height: 1.25rem;
		}

		.lx-win-body {
			height: calc(100% - 1.25rem);
		}

		.lx-url {
			display: none;
		}
	}
</style>
