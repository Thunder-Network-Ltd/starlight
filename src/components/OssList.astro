---
/**
 * 开源组件清单：一个组件一格——名称（链到源码）、许可证，下面一行是用途与版本。
 * 2026-10-14 起是一行四列（名称 / 版本 / 许可证圆角标签 / 源码网址）；10-17 用户嫌不好看：
 * 一长串蓝色网址抢眼、许可证胶囊显得廉价、每行很高，17 行拉得很长。
 * 现在网址收进名称的链接里，宽的时候两格一排，窄的时候一格一排（按列表自身宽度，不按视口——
 * 视口 720–1000 px 时左边还有侧栏，正文只剩约 480 px）。
 */
interface Item {
	name: string;
	/** 一句话说它是做什么的 */
	role: string;
	version: string;
	license: string;
	/** 源码地址；不给时名称不带链接，在用途后面显示 sourceText（例如「源码同 libmedia」） */
	href?: string;
	sourceText?: string;
}

interface Props {
	items: Item[];
}

const { items } = Astro.props;
---

<div class="lx-oss-wrap not-content">
<ul class="lx-oss">
	{
		items.map((it) => (
			<li>
				<div class="lx-oss-top">
					{it.href ? (
						<a class="lx-oss-name" href={it.href} rel="noopener">
							{it.name}
							<svg aria-hidden="true" viewBox="0 0 16 16" width="11" height="11">
								<path d="M5 3h8v8M13 3 3 13" fill="none" stroke="currentColor" stroke-width="1.6" />
							</svg>
						</a>
					) : (
						<span class="lx-oss-name">{it.name}</span>
					)}
					<span class="lx-oss-license">{it.license}</span>
				</div>
				<div class="lx-oss-meta">
					<span>{it.sourceText ? `${it.role}，${it.sourceText}` : it.role}</span>
					<span class="lx-oss-version">{it.version}</span>
				</div>
			</li>
		))
	}
</ul>
</div>

<style>
	/* 容器查询只能改容器里面的元素，所以宽度按外面这层量，两格一排写在 ul 上 */
	.lx-oss-wrap {
		container-type: inline-size;
		margin: 1.25rem 0 1.75rem;
	}

	.lx-oss {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 1px;
		margin: 0;
		padding: 0;
		list-style: none;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 10px;
		/* 格与格之间的 1px 间隙露出这层底色，当作分隔线 */
		background: var(--sl-color-hairline);
		overflow: hidden;
	}

	li {
		display: grid;
		gap: 0.3rem;
		align-content: start;
		margin: 0;
		padding: 0.8rem 1rem;
		background: var(--lumen-panel);
	}

	.lx-oss-top,
	.lx-oss-meta {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.75rem;
		min-width: 0;
	}

	.lx-oss-name {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		min-width: 0;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		color: var(--sl-color-white);
		text-decoration: none;
	}

	.lx-oss-name svg {
		flex: none;
		color: var(--sl-color-gray-4);
		transition: color 0.15s;
	}

	a.lx-oss-name:hover {
		color: var(--lumen-accent-text);
	}

	a.lx-oss-name:hover svg {
		color: currentColor;
	}

	.lx-oss-license {
		flex: none;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
		white-space: nowrap;
	}

	.lx-oss-meta {
		font-size: var(--sl-text-xs);
		line-height: 1.5;
		color: var(--sl-color-gray-3);
	}

	.lx-oss-version {
		flex: none;
		font-family: var(--__sl-font-mono);
		color: var(--sl-color-gray-4);
	}

	@container (min-width: 34rem) {
		.lx-oss {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		/* 单数个时最后一格占满一排，免得右下角露出一块分隔线底色 */
		li:last-child:nth-child(odd) {
			grid-column: 1 / -1;
		}
	}
</style>
