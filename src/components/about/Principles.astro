---
/**
 * 「我们的理念」：四条信念，两列排开，每条是编号、标题和一句佐证。
 * 以前用 Starlight 的 Card：图标方框 + 大号标题，标题在半栏里折成两行（「您应该看得到每一项用量」只剩一个「量」），
 * 四个框也显得笨重（2026-10-14 用户：很丑）。这里去掉框和图标，只留顶部细线与编号。
 */
interface Principle {
	title: string;
	body: string;
}

interface Props {
	items: Principle[];
}

const { items } = Astro.props;
---

<ol class="lx-principles not-content">
	{
		items.map((item, i) => (
			<li>
				<span class="lx-p-num">{String(i + 1).padStart(2, '0')}</span>
				<h3>{item.title}</h3>
				<p>{item.body}</p>
			</li>
		))
	}
</ol>

<style>
	.lx-principles {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		column-gap: 2.5rem;
		row-gap: 2rem;
		margin: 1.5rem 0 0.5rem;
		padding: 0;
		list-style: none;
	}

	li {
		margin: 0;
		padding-top: 1rem;
		border-top: 1px solid var(--sl-color-hairline-light);
	}

	.lx-p-num {
		display: block;
		margin-bottom: 0.6rem;
		font-size: var(--sl-text-xs);
		font-weight: 600;
		font-variant-numeric: tabular-nums;
		letter-spacing: 0.04em;
		color: var(--lumen-accent-text);
	}

	h3 {
		margin: 0 0 0.5rem;
		font-size: var(--sl-text-lg);
		font-weight: 600;
		line-height: 1.4;
		color: var(--sl-color-white);
	}

	p {
		margin: 0;
		font-size: var(--sl-text-sm);
		line-height: 1.75;
		color: var(--sl-color-gray-2);
	}

	@media (max-width: 40rem) {
		.lx-principles {
			grid-template-columns: 1fr;
			row-gap: 1.5rem;
		}
	}
</style>
